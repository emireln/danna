# To point a build at a different Supabase project, copy this file to .env.local and fill it in
# (Supabase dashboard -> Project Settings -> API). .env.local is never committed.
# The publishable key is public by design; row-level security in supabase/schema.sql protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
