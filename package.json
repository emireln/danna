{
  "name": "danna",
  "productName": "danna",
  "version": "0.5.0",
  "description": "danna: an English learning desktop app, from A1 to C1, with an optional TOEFL warm-up, AI tutoring, roadmaps and friends.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,app -c blue,green \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env DANNA_DEV_URL=http://localhost:5173 electron .\"",
    "web": "vite --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\" \"supabase/tests/*.test.mjs\"",
    "test:sync": "node --test tests/migrate.test.mjs",
    "test:db": "node --test supabase/tests/policies.test.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "bump": "node scripts/bump-version.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "husky",
    "logos": "node scripts/make-platform-logos.mjs",
    "installer-art": "node scripts/make-installer-art.mjs",
    "art": "npm run icons && npm run logos && npm run installer-art"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "electron-updater": "^6.8.11",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.72.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource/unbounded": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "husky": "^9.1.7",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.37.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "app.danna.desktop",
    "publish": [
      {
        "provider": "github",
        "owner": "emireln",
        "repo": "danna",
        "releaseType": "release"
      }
    ],
    "productName": "danna",
    "copyright": "Copyright (c) danna",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "danna-setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "danna",
      "uninstallDisplayName": "danna",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    }
  }
}
