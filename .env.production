# meant for apps, and row-level security in supabase/schema.sql is what protects the data.
# Never put a secret or service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://coveufyhdqvqawhtnwap.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_k-6GAdD998AIijbSxJ-Ofg_41SswhB8
# The storage gateway for files (worker/storage). It holds only a public address; the apps send each file request to it.
VITE_STORAGE_WORKER_URL=https://danna-storage.emirlima114.workers.dev
